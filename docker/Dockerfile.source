# Builds TunnixNode from source (for local builds without a release).
#   docker build -f docker/Dockerfile.source -t tunnix-node .
FROM rust:1-bookworm AS build
RUN apt-get update && apt-get install -y --no-install-recommends cmake clang musl-tools && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN case "$(uname -m)" in x86_64) T=x86_64-unknown-linux-musl ;; aarch64) T=aarch64-unknown-linux-musl ;; esac \
 && rustup target add $T \
 && cargo build --release --locked -p tunnix-node --target $T \
 && cp target/$T/release/tunnix-node /tunnix-node

FROM gcr.io/distroless/static-debian12
COPY --from=build /tunnix-node /usr/local/bin/tunnix-node
VOLUME ["/etc/tunnix-node", "/var/lib/tunnix-node"]
ENTRYPOINT ["/usr/local/bin/tunnix-node"]
CMD ["server", "-c", "/etc/tunnix-node/config.json"]
